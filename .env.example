# Public site URL - used for canonical URLs, sitemap, and JSON-LD structured data.
# Set this to your real production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://investsproperty.com

# Default WhatsApp number for site-wide "Talk to an Expert" buttons (header, homepage CTA).
# Digits only, with country code, no + or spaces. Example: 91 followed by 10-digit number.
NEXT_PUBLIC_DEFAULT_WHATSAPP=919999999999

# Default phone number for site-wide contact links (footer).
# E.164 format with +.
NEXT_PUBLIC_DEFAULT_PHONE=+919999999999

# Optional: Google Analytics 4 measurement ID (GA Admin → Data streams → Web).
# When set, GA loads on the public site (not /admin) and records page views plus
# view_number, call_click and whatsapp_click events with a project_name param.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---------- Backend ----------
# Put real values in .env.local (git-ignored) — never in this file.

# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require

# Signs the login cookie (JWT). Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ImageKit (Dashboard → Developer options). Used by POST /api/upload.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
